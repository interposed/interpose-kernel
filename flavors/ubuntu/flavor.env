# interpose-kernel — Ubuntu flavor config
#
# Sourced by ../../build.sh ubuntu. Documents which Ubuntu kernel deb
# this flavor packages, where to find it, and which signing key to trust.
#
# Update KERNEL_VERSION (and KERNEL_VERSION_FULL) when shipping a new
# release. Everything else stays constant for a given UBUNTU_RELEASE.

FLAVOR_NAME=ubuntu
DISTRO_FAMILY=deb                  # deb-based; uses Dockerfile.deb

# Builder image — ubuntu:24.04 so apt is preconfigured against Ubuntu's
# noble archive (correct mirror routing, correct keyring, correct pool layout)
BUILDER_IMAGE=ubuntu:24.04

# Which Ubuntu LTS we're pulling from
UBUNTU_RELEASE=24.04
UBUNTU_CODENAME=noble

# The specific kernel deb. Update on every rebuild.
#
# In Ubuntu 24.04, `linux-image-virtual` is a META package that depends on
# `linux-image-${ABI}-generic` — there is no separate `linux-image-virtual`
# kernel deb. So we fetch `generic` directly. (Older Ubuntu releases had a
# truly distinct `virtual` kernel; 24.04 doesn't.)
#
# Look up the current value with:
#   docker run --rm ubuntu:24.04 sh -c 'apt-get update -qq && apt-cache show linux-image-virtual | head'
#
# The deb filename pattern is:
#   linux-image-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}_${KERNEL_DEB_DELTA}_${ARCH}.deb
KERNEL_VARIANT=generic
KERNEL_VERSION=6.8.0-117                # current ABI version (was 6.8.0-31 at 24.04 release)
KERNEL_VERSION_FULL=6.8.0-117
KERNEL_DEB_DELTA=6.8.0-117.117          # Canonical's full package version (ABI + upload number)

# Packages to download via apt-get download. Ubuntu splits the kernel
# install across 3 debs:
#   linux-image-${V}-${VAR}     — vmlinuz only
#   linux-modules-${V}-${VAR}   — System.map + config + modules
#   linux-headers-${V}-${VAR}   — kernel headers (for compiling BPF programs)
# Each is pinned to KERNEL_DEB_DELTA so the build is reproducible.
KERNEL_DEB_PACKAGES="linux-image-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}=${KERNEL_DEB_DELTA} linux-modules-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}=${KERNEL_DEB_DELTA} linux-headers-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}=${KERNEL_DEB_DELTA}"

# Mirror to pull from. archive.ubuntu.com is the canonical source.
DEB_MIRROR=http://archive.ubuntu.com/ubuntu

# Pool path within the mirror
DEB_POOL_PATH=pool/main/l/linux

# GPG keyring — fetched directly from Ubuntu's archive at build time.
# Canonical publishes the keyring as a binary .gpg file at this stable URL.
# We curl + verify the fingerprint matches what we expect, then use gpgv.
GPG_KEYRING_URL=https://archive.ubuntu.com/ubuntu/project/ubuntu-archive-keyring.gpg
# Expected fingerprint of Ubuntu's archive signing key (Ubuntu Archive Automatic Signing Key).
# Verify with: `gpg --show-keys ubuntu-archive-keyring.gpg`
GPG_KEY_FINGERPRINT="871920D1991BC93C"

# Tagging
TAG_PREFIX=ubuntu-${UBUNTU_RELEASE}
