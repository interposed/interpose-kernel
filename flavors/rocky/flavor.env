# interpose-kernel — Rocky Linux flavor config
#
# Sourced by ../../build.sh rocky. Rocky 9 = RHEL 9 rebuild;
# kernel-5.14 with extensive backports.

FLAVOR_NAME=rocky
DISTRO_FAMILY=rpm                 # rpm-based; uses Dockerfile.rpm

ROCKY_RELEASE=9
ROCKY_MINOR=9.4                   # current Rocky 9 point release; bump on rebuild

# Kernel rpm. Rocky kernels are `kernel-${VERSION}.${ARCH}.rpm` with separate
# kernel-core, kernel-modules, kernel-modules-extra rpms.
KERNEL_VERSION=5.14.0-503.14.1.el9_5    # current rocky 9.4 kernel; bump on rebuild
KERNEL_RPMS="kernel kernel-core kernel-modules kernel-modules-core"

# Rocky mirror — using cdn-cloud (geographically routed)
RPM_MIRROR=http://download.rockylinux.org/pub/rocky

# Rocky's GPG key (RPM-GPG-KEY-Rocky-9). Fingerprint changes per major version.
GPG_KEY_URL=https://download.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9
GPG_KEY_FINGERPRINT="350D275CD5BAAD05"      # short ID; full fingerprint verified in Dockerfile

# Tagging
TAG_PREFIX=rocky-${ROCKY_RELEASE}
