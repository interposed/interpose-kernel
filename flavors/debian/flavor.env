# interpose-kernel — Debian flavor config
#
# Sourced by ../../build.sh debian. Documents which Debian kernel deb
# this flavor packages, mirror, and signing key.

FLAVOR_NAME=debian
DISTRO_FAMILY=deb                 # deb-based; uses Dockerfile.deb

# Builder image — debian:bookworm-slim so apt is preconfigured against
# Debian's bookworm archive
BUILDER_IMAGE=debian:bookworm-slim

# Which Debian stable we're pulling from
DEBIAN_RELEASE=12
DEBIAN_CODENAME=bookworm

# The specific kernel deb. Update on every rebuild.
#
# Debian's package layout includes the arch in the variant name:
#   linux-image-${VER}-cloud-arm64    (vs. Ubuntu's `linux-image-${VER}-generic`)
# So KERNEL_VARIANT here is "cloud-arm64", not just "cloud".
#
# Look up the current value with:
#   docker run --rm --platform linux/arm64 debian:bookworm-slim sh -c \
#     'apt-get update -qq && apt-cache show linux-image-cloud-arm64 | head'
#
# Debian's kernel deb is monolithic: vmlinuz + System.map + config + modules
# all in one package. Headers are split: `linux-headers-${VER}-cloud-arm64`
# depends on `linux-headers-${VER}-common` (architecture-independent common
# headers), so we download both.
KERNEL_VARIANT=cloud-arm64
KERNEL_VERSION=6.1.0-48                # current Debian 12 cloud-arm64 (was 6.1.0-25 a year ago)
KERNEL_VERSION_FULL=6.1.0-48
KERNEL_DEB_DELTA=6.1.172-1             # Debian's full package version

KERNEL_DEB_PACKAGES="linux-image-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}=${KERNEL_DEB_DELTA} linux-headers-${KERNEL_VERSION_FULL}-${KERNEL_VARIANT}=${KERNEL_DEB_DELTA} linux-headers-${KERNEL_VERSION_FULL}-common=${KERNEL_DEB_DELTA}"

# Debian mirror
DEB_MIRROR=http://deb.debian.org/debian

# Pool path
DEB_POOL_PATH=pool/main/l/linux

# GPG keyring — debian-archive-keyring is in Debian's own repo (this is
# the Debian builder image's native distro), so we use apt for this flavor.
GPG_KEYRING_PACKAGE=debian-archive-keyring
GPG_KEY_FINGERPRINT=""   # unused; the apt-installed keyring is trusted by virtue of the builder distro

# Tagging
TAG_PREFIX=debian-${DEBIAN_RELEASE}
